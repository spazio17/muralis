# Bind mounts for the containerized build: SDK packages and Gradle caches. Both
# are regenerated by scripts/build-container.sh and must never be committed.
/.android-sdk/
/.gradle/

# Gradle outputs
/.gradle-build/
/app/build/
local.properties

# Provisioning payloads (embed a LAN address, a signing checksum): regenerated per
# session by scripts/make-provisioning-qr.sh, never committed.
/provisioning/
