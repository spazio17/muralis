# Bind mounts for the containerized build: SDK packages and Gradle caches. Both
# are regenerated by scripts/build-container.sh and must never be committed.
/.android-sdk/
/.gradle/

# Gradle outputs
/.gradle-build/
/app/build/
local.properties

# Device-specific / environment-specific artifacts (provisioning payloads, package
# inventories from a specific physical device). Regenerate per device rather than
# committing: they embed a LAN address, a signing checksum, and a device serial.
/provisioning/
/device-baseline/
/device-baseline-after-reset/
