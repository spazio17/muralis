<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from ../wall-kiosk-rom/packages/apps/KiOSkLauncher/AndroidManifest.xml
     with every privileged capability removed, per that repo's
     docs/play-store-viability.md and the decisions in its
     docs/resume-checkpoint.md. Deliberately absent, and not to be re-added:
       DEVICE_POWER / REBOOT      - signature-only; system.shutdown is deleted
                                    outright and falls through to "unsupported",
                                    NOT re-added as a no-op, and reboot goes
                                    through DevicePolicyManager.reboot() as
                                    device owner.
       STATUS_BAR                 - signature-only; lock task does this job.
       WRITE_SECURE_SETTINGS      - signature-only; no policy_control equivalent.
       android:persistent         - system-app-only attribute.
       lineageos.permission.*     - no LineageOS SetupWizard on stock Android,
       SetupFinishedReceiver        so there is nothing to hand off from. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Guards the internal UI_CONTROL broadcast KioskService sends to KioskActivity.
         signature protection level, so only a build signed with the same key can hold it,
         i.e. only this app. Needed because a context-registered receiver was implicitly
         EXPORTED before Android 14 and RECEIVER_NOT_EXPORTED is only API 33: without this,
         on the API 26 hardware this app targets, any installed app could broadcast the
         action and repoint, blank or dim the kiosk. -->
    <permission
        android:name="org.spazio17.muralis.permission.UI_CONTROL"
        android:protectionLevel="signature" />
    <uses-permission android:name="org.spazio17.muralis.permission.UI_CONTROL" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required from API 34 in addition to FOREGROUND_SERVICE, matched to the
         android:foregroundServiceType on KioskService below. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Runtime permission from API 33 for the notification KioskService must
         post to stay alive. Ask for it at runtime; a denial must not be fatal. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      The pictures screensaver's own folder browser, decided 2026-09-10.

      This reverses the decision of 2026-09-09 to hold no storage permission at all and reach a
      folder only through the system picker's persisted grant. The reason is the kiosk promise, not
      convenience: handing the screen to Android's file picker takes a locked panel outside Muralis
      for as long as somebody is choosing, with no tap combination performed, and playlists are
      also built from the web admin on another computer, where no system picker can appear.
      Browsing the pictures from inside the app needs a read permission; there is no third way.
      The system picker path is retired on every install.

      How it is granted: a device owner grants it to itself silently
      (KioskService.grantOwnRuntimePermissions), so no dialog ever appears on a screen nobody is
      standing at; an ordinary install asks once, with Android's own dialog, from the Screensaver
      page (KioskActivity.requestPicturePermission). The permission is read-only and is used for
      one thing, listing and decoding the pictures a person picks.

      Play consequence: READ_MEDIA_IMAGES is a declared-use-case permission under the photo and
      video policy. The declaration was filed with 0.6.0 (2026-09-25): a slideshow that runs for
      months from folders the owner browses, and a system picker that cannot open in a remote
      browser or in a locked kiosk.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android 14's "Select photos and videos" answer to the dialog above. Declared so a partial
         grant is a grant that lasts: without it the system hands READ_MEDIA_IMAGES over for the
         session only and asks again at the next start (vendor docs, 2026-09-19). -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- The Bluetooth and NFC state sensors (Sensors.java) read whether each radio is on.
         Both are normal permissions; BLUETOOTH is only asked for below Android 12, where
         isEnabled() still wants it. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Not granted by installing: an "appop" the user allows via ACTION_MANAGE_WRITE_SETTINGS, or
         `adb shell appops set org.spazio17.muralis WRITE_SETTINGS allow`. Needed for the two
         brightness controls, which write Settings.System.SCREEN_BRIGHTNESS_MODE and
         SCREEN_BRIGHTNESS (KioskService.applyBrightness); there is no device-owner setter for the
         System namespace. The interim MediaPad does have a light sensor
         (als-bh1745), so unlike the ROM's tablet this path is live and testable here. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- Package visibility, required from API 30 (targetSdk 30+). Without this, the escape hatch
         breaks on any modern device: queryIntentActivities/resolveActivity return a FILTERED list, so
         Muralis cannot find the OEM launcher to hand the screen to. Not a problem on the API 26
         MediaPad, which predates filtering, which is exactly why it would have gone unnoticed until
         the first newer panel.

         Declared as one specific intent rather than QUERY_ALL_PACKAGES on purpose: the broad
         permission is one Google requires a separate declaration and justification for, and this app
         only ever needs to find the launcher. Settings screens are started, never looked up, and a
         start needs no visibility; the Settings entry that stood here backed nothing and was removed
         on 2026-09-25. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.software.webview" android:required="true" />
    <!-- Not required, said out loud because Play would otherwise infer the opposite: holding
         ACCESS_WIFI_STATE (for the signal-strength stat) makes Play treat android.hardware.wifi
         as required and hide the app from any device without a Wi-Fi radio. A wall panel on
         PoE Ethernet is exactly such a device. The service copes with a missing WifiManager. -->
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <application
        android:name=".MuralisApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:directBootAware="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Muralis"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic is app-wide and stays that way, a decision rather than an
             omission. What actually needs it is the dashboard WebView and the server probe: a
             typical Home Assistant install on a home LAN is plain http, and the host is whatever
             the operator types at runtime, so a network-security-config allowlist (which is
             static XML, resolved at install) cannot express it; scoping to specific domains
             would just break the next customer's URL. The app's own sockets are unaffected
             either way: both the admin server and Paho MQTT use raw java.net sockets, which
             bypass the platform's cleartext policy entirely. -->

        <!-- Device-owner component, provisioned with
             `adb shell dpm set-device-owner org.spazio17.muralis/.KioskDeviceAdminReceiver`.
             Device-owner status is the single thing standing in for the lost
             privileged permissions: it is what makes lock task suppress SystemUI
             rather than merely making the bars inert. -->
        <receiver
            android:name=".KioskDeviceAdminReceiver"
            android:description="@string/device_admin_description"
            android:label="@string/device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- No excludeFromRecents, since 2026-08-27 (it was true). On the kiosk it never mattered:
             lock task disables the Overview button, so the panel shows no recents either way. On an
             ordinary install it did exactly the wrong thing: the recents card is the one close
             mechanism every Android user already knows, and hiding it made the app feel
             unkillable. KioskService.onTaskRemoved is the other half: swiping the card also stops
             the service on a non-device-owner install, so the swipe genuinely closes the app. -->
        <activity
            android:name=".KioskActivity"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:directBootAware="false"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="fullSensor"
            android:windowSoftInputMode="adjustResize">
            <!-- No android:priority here, unlike the ROM build: priority on a HOME filter only
                 works for a platform-signed app in the system image, and there is no Lineage
                 SetupWizard to outrank anyway. This filter alone does NOT make Muralis the launcher,
                 verified on the MediaPad where com.huawei.android.launcher kept winning; HOME is
                 claimed at runtime by KioskDeviceAdminReceiver.pinAsHomeActivity() via the
                 device-owner addPersistentPreferredActivity API. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".BootReceiver"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
            </intent-filter>
        </receiver>

        <!-- foregroundServiceType is mandatory from Android 10 and enforced
             strictly at targetSdk 34+. "specialUse" is the honest category for a
             kiosk supervisor: it is not media, location, or sync. A Play
             submission using specialUse must justify it in the console. -->
        <service
            android:name=".KioskService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent single-purpose kiosk launcher supervising a Home Assistant dashboard on wall-mounted hardware." />
        </service>
    </application>
</manifest>
