<?xml version="1.0" encoding="utf-8"?>
<!-- The screen reader's Move up and Move down on a playlist's held picture, the drag's
     equivalent for somebody who cannot drag (KioskActivity.HeldMoveActions). Resource ids so
     they can never collide with the platform's own accessibility actions. -->
<resources>
    <item name="held_move_up" type="id" />
    <item name="held_move_down" type="id" />
    <!-- A segment row's state, {whether it is its list's first, its fill or null for the card's}; see KioskActivity.addListRow and addMenuRow. -->
    <item name="segment_state" type="id"/>
    <!-- A camera view's open streams (CameraView.Streams), closed with the view. -->
    <item name="camera_streams" type="id"/>
    <!-- A left menu's row: whether it is the chosen one, and what opens it; see addMenuRow. -->
    <item name="menu_chosen" type="id"/>
    <item name="menu_open" type="id"/>
</resources>
