<?xml version="1.0" encoding="utf-8"?>
<!--
  Titles and the public URLs only, and deliberately nothing a reader could mistake for part of a
  document: a "draft placeholder" banner lived here until 2026-09-03 and went on claiming the text
  was unreviewed and undistributed long after both had stopped being true. Anything to be said
  about a document is said inside it, in the muralis-site repo. The document bodies live in
  res/raw/privacy.txt and res/raw/terms.txt, which are VERBATIM COPIES of the canonical
  texts in the muralis-site repo (legal/privacy.txt, legal/terms.txt), the single source of truth
  decided 2026-08-25. Edit them there, run scripts/sync-legal.sh here; the release workflow
  byte-compares the copies and refuses to release while they differ.

  Why not string resources: aapt collapses literal newlines in a <string>, so the first version of
  these rendered as one unbroken wall of text with the headings absorbed mid-sentence. Escaping every
  break as \n would work but makes a long document unreadable in source and unpleasant to hand to
  anyone for review. res/raw preserves the file byte for byte, needs no XML escaping (no apostrophe
  traps either), and means the replacement text can be dropped in as a plain .txt file.

  Format the renderer expects: blocks separated by blank lines; a block in ALL CAPS is a heading.
-->
<resources>
    <string name="privacy_policy_title">Privacy policy</string>
    <string name="terms_title">Terms and conditions</string>
    <!-- One sentence, one pair of URLs, shared by the About screen and the web admin so the two
         surfaces cannot drift. The tablet renders the URL as plain text (no browser under lock
         task); the web admin renders it as a link. -->
    <string name="legal_also_published">This document is also published at %1$s</string>
    <string name="legal_privacy_url">https://muralis.spazio17.org/privacy/</string>
    <string name="legal_terms_url">https://muralis.spazio17.org/terms/</string>
</resources>
