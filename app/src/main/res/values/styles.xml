<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Muralis" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorAccent">#03A9F4</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <!-- android:windowLightNavigationBar is API 27; it lives in values-v27/styles.xml so
             API 26 does not try to resolve an attribute its framework has never heard of. -->
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
